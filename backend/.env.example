# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Production: use the TRANSACTION pooler (port 6543) for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Migrations / db push need the SESSION pooler (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── JWT (generate strong unique secrets — e.g. `openssl rand -hex 32`) ───────
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Comma-separated allow-list of frontend origins
FRONTEND_URL="https://your-app.vercel.app"
# Expose Swagger in production only if you really need it
ENABLE_SWAGGER=false

# ─── Supabase (optional, for client SDK use) ─────────────────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
